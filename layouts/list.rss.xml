{{- $pages := .Pages -}}
{{- if .IsHome -}}
  {{- $sections := site.Params.mainSections | default (slice "posts") -}}
  {{- $pages = where site.RegularPages "Section" "in" $sections -}}
{{- else if .IsSection -}}
  {{- $pages = .RegularPages -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>
      {{- if .IsHome -}}
        {{- site.Params.description -}}
      {{- else -}}
        Conteúdo recente em {{ .Title }} no {{ site.Title }}.
      {{- end -}}
    </description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Locale }}</language>
    {{- if gt (len $pages) 0 }}
      {{- $latest := index $pages.ByLastmod.Reverse 0 }}
      {{- if not $latest.Lastmod.IsZero }}
        <lastBuildDate>{{ $latest.Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
      {{- end }}
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
      {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- range $pages }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        {{- if not .PublishDate.IsZero }}
          <pubDate>{{ .PublishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
        {{- end }}
        <guid isPermaLink="true">{{ .Permalink }}</guid>
        <description>{{ .Summary | transform.XMLEscape | safeHTML }}</description>
      </item>
    {{- end }}
  </channel>
</rss>
